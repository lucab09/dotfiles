#!/usr/bin/env sh

CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"
SWIFT_BAR_DIR="$CONFIG_DIR/swift_bar"

# SketchyBar resta attivo soltanto come supervisore dei processi. La vecchia
# barra nativa e tutti i suoi item vengono rimossi: l'unica UI visibile è la
# barra Swift/AppKit avviata qui sotto.
sketchybar --remove '/.*/' 2>/dev/null || true
sketchybar --bar drawing=off

# Chiude eventuali popup rimasti aperti durante un reload.
pkill -f '^.*/weather_popup$' 2>/dev/null || true

# Barra principale Swift.
"$SWIFT_BAR_DIR/run.sh" >>/tmp/sketchybar_swift_bar_supervisor.log 2>&1

# Popup rete persistente.
if [ -f /tmp/network_popup.pid ]; then
  kill "$(cat /tmp/network_popup.pid)" 2>/dev/null || true
fi
if [ -x "$PLUGIN_DIR/network_popup" ]; then
  "$PLUGIN_DIR/network_popup" >>/tmp/network_popup.log 2>&1 &
  echo $! >/tmp/network_popup.pid
fi

# Agenda/calendario persistente. Avviarlo come figlio del servizio SketchyBar
# preserva l'identità responsabile usata dai permessi Calendar e Contacts.
if [ -f /tmp/calendar_notch.pid ]; then
  kill "$(cat /tmp/calendar_notch.pid)" 2>/dev/null || true
fi
if [ -x "$PLUGIN_DIR/calendar_notch" ]; then
  "$PLUGIN_DIR/calendar_notch" >>/tmp/calendar_notch.log 2>&1 &
  echo $! >/tmp/calendar_notch.pid
fi

sketchybar --update
